# ==============================================================================
# Microservice 1: XGO Mini 2S Low-Level Hardware Driver (C++20)
# ==============================================================================
FROM ros:jazzy-ros-base

ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies for compilation and serial communication
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    python3-colcon-common-extensions \
    ros-jazzy-geometry-msgs \
    ros-jazzy-sensor-msgs \
    ros-jazzy-nav-msgs \
    ros-jazzy-tf2-ros \
    ros-jazzy-tf2-geometry-msgs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /ros2_ws

# Copy package source
COPY . /ros2_ws/src/xgo_driver_cpp

# Build driver in Release mode
RUN . /opt/ros/jazzy/setup.sh && \
    colcon build --packages-select xgo_driver_cpp \
    --cmake-args -DCMAKE_BUILD_TYPE=Release

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["ros2", "launch", "xgo_driver_cpp", "xgo_driver.launch.py"]

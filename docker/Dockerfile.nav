# ==============================================================================
# Microservice 2: XGO Mini 2S Lightweight Nav2 Autonomous Navigation Stack
# ==============================================================================
FROM ros:jazzy-ros-base

ENV DEBIAN_FRONTEND=noninteractive

# Install Nav2 stack and MPPI controller
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-navigation2 \
    ros-jazzy-nav2-bringup \
    ros-jazzy-nav2-mppi-controller \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /nav2_ws

# Copy navigation configuration and map files
COPY config/nav2_params.yaml /nav2_ws/config/nav2_params.yaml
COPY maps/ /nav2_ws/maps/

# Launch script
COPY docker/entrypoint_nav.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["ros2", "launch", "nav2_bringup", "bringup_launch.py", \
     "map:=/nav2_ws/maps/room_map.yaml", \
     "params_file:=/nav2_ws/config/nav2_params.yaml", \
     "use_sim_time:=False", \
     "autostart:=True", \
     "use_composition:=False"]

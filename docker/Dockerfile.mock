# ==============================================================================
# Microservice: XGO Mini 2S Virtual MCU & LiDAR Simulator
# ==============================================================================
FROM ros:jazzy-ros-base

ENV DEBIAN_FRONTEND=noninteractive

# Install Python Tkinter, NumPy, and ROS 2 dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-tk \
    python3-numpy \
    ros-jazzy-sensor-msgs \
    ros-jazzy-geometry-msgs \
    ros-jazzy-nav-msgs \
    ros-jazzy-tf2-ros \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy mock script and room map
COPY mock/ /app/mock/
COPY maps/ /app/maps/
RUN chmod +x /app/mock/mock_esp32.py

ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["/bin/bash", "-c", "source /opt/ros/jazzy/setup.bash && python3 /app/mock/mock_esp32.py \"$@\"", "--"]
CMD []

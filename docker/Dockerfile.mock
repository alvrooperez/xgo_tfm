# ==============================================================================
# Microservice: XGO Mini 2S Virtual MCU (ESP32) Hardware Simulator
# ==============================================================================
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-tk \
    tk \
    && rm -rf /var/lib/apt/lists/*

# Copy mock simulator script
COPY mock/mock_esp32.py /app/mock_esp32.py
RUN chmod +x /app/mock_esp32.py

ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python3", "/app/mock_esp32.py"]
CMD []

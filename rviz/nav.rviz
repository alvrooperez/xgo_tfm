Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Line Style:
        Value: Lines
      Cell Size: 1
      Plane: XY
    - Class: rviz_default_plugins/Map
      Name: StaticMap
      Enabled: true
      Topic:
        Value: /map
      Alpha: 0.7
      Color Scheme: map
      Draw Behind: false
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Marker Scale: 0.3
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
      Size (m): 0.05
      Style: Rainbow
      Color Transformer: AxisColor
      Decay Time: 0
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /odom
      Shape:
        Value: Arrow
      Color: 255; 255; 0
      Keep: 100
    - Class: rviz_default_plugins/PoseArray
      Name: ParticleCloud
      Enabled: true
      Topic:
        Value: /particle_cloud
      Color: 0; 255; 0
      Arrow Length: 0.2
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: AmclPose
      Enabled: true
      Topic:
        Value: /amcl_pose
      Color: 255; 0; 0
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10.0
      Pitch: 1.2
      Yaw: 0.0
      Target Frame: base_footprint
      Value: Orbit (rviz)
